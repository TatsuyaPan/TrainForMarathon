{
  "name": "@train-for-marathon/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "spec"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dsl/*": {
      "types": "./dist/dsl/*.d.ts",
      "import": "./dist/dsl/*.js"
    },
    "./spec/dsl/*": "./spec/dsl/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node scripts/generate-content.mjs && tsc -p tsconfig.json && node scripts/sync-spec.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:spec": "node scripts/sync-spec.mjs --check"
  }
}
