{
  "name": "@train-for-marathon/core",
  "version": "0.1.0",
  "description": "TrainForMarathon 平台无关领域核心：课表实例化、配速分档、训练会话生命周期，以及按版本冻结的 Workout DSL。",
  "license": "CC0-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "spec"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dsl/*": {
      "types": "./dist/dsl/*.d.ts",
      "import": "./dist/dsl/*.js"
    },
    "./spec/dsl/*": "./spec/dsl/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TatsuyaPan/TrainForMarathon.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/TatsuyaPan/TrainForMarathon#readme",
  "bugs": {
    "url": "https://github.com/TatsuyaPan/TrainForMarathon/issues"
  },
  "keywords": [
    "running",
    "marathon",
    "training-plan",
    "daniels",
    "vdot",
    "workout-dsl"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node scripts/generate-content.mjs && tsc -p tsconfig.json && node scripts/sync-spec.mjs && node scripts/sync-license.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:spec": "node scripts/sync-spec.mjs --check && node scripts/sync-license.mjs --check"
  }
}
