{
  "name": "@train-for-marathon/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dsl/*": {
      "types": "./dist/dsl/*.d.ts",
      "import": "./dist/dsl/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-content.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
