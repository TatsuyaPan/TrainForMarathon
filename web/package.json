{
  "name": "train-for-marathon-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "TrainForMarathon 核心包演示/测试层：零登录，localStorage 持久化，与微信小程序共用同一套核心调用。UI 基于 Vue 3 + TDesign。",
  "scripts": {
    "sync:assets": "node scripts/sync-web-assets.mjs",
    "dev": "npm run sync:assets && vite",
