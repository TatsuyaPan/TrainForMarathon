    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "tdesign-vue-next": "^1.20.7",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "^18.0.1",
    "vitest": "^3.2.4",
    "vite": "^5.4.0"
  }
}
